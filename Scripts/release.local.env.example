# Copy to Scripts/release.local.env (which git ignores) and fill in your own settings for
# Scripts/release.sh. A variable already set in the environment wins over this file.

# The keychain profile `xcrun notarytool store-credentials <name>` saved. Without it, a release
# is signed but not notarized.
RETAKE_NOTARY_PROFILE=

# A Developer ID Application identity's name or SHA-1. Leave it empty to use the keychain's one
# Developer ID Application identity, when it has exactly one.
RETAKE_RELEASE_IDENTITY=

# Where to build. Leave it empty to build in the output directory's .build/.
RETAKE_RELEASE_SCRATCH=
