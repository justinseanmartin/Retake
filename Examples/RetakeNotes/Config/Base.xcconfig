// RetakeNotes signs for development with your own team. Copy Signing.example.xcconfig to
// Signing.local.xcconfig, which isn't checked in, and fill in your team and a bundle ID prefix of
// your own: bundle IDs are unique across Apple's developer accounts, so the example's can't be.

BUNDLE_ID_PREFIX = com.example.retake
DEVELOPMENT_TEAM =

#include? "Signing.local.xcconfig"

PRODUCT_BUNDLE_IDENTIFIER = $(BUNDLE_ID_PREFIX).notes
CODE_SIGN_STYLE = Automatic
