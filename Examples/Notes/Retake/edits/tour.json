{
  "$schema": "https://justinseanmartin.github.io/Retake/schemas/0.0.1/edit.schema.json",
  "intent": "Notes in a few seconds: getting started, then a note written, synced and shared.",
  "devices": ["iphone", "ipad"],
  "background": "#F4F1EA",
  "clips": [
    {
      "id": "welcome",
      "intent": "The welcome screen, and Get Started tapped.",
      "take": "first-launch",
      "from": { "step": "welcome" },
      "to": { "step": "get-started", "offset": 0.5 },
      "touches": true,
      "captions": [
        { "text": "Start writing in seconds", "y": 0.1, "color": "#1F6FEB", "ipad": { "y": 0.08 } }
      ]
    },
    {
      "id": "write",
      "intent": "A new note, titled, then synced.",
      "take": "create-note",
      "from": { "step": "new-note" },
      "to": { "step": "synced", "offset": 0.8 },
      "crossfade": 0.4,
      "touches": true,
      "captions": [
        { "text": "Jot it down", "y": 0.1, "color": "#1F6FEB", "to": { "clip": "share" } }
      ]
    },
    {
      "id": "share",
      "intent": "The note shared, until it's sent.",
      "take": "create-note",
      "from": { "step": "share" },
      "to": { "step": "sent", "offset": 0.8 },
      "speed": 1.2,
      "crossfade": 0.3,
      "touches": true,
      "ipad": { "speed": 1.4 }
    }
  ]
}
