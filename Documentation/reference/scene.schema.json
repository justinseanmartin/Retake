{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://justinseanmartin.github.io/Retake/schemas/0.0.1/scene.schema.json",
  "title": "A scene",
  "description": "A scene: a set, and the steps played on it.",
  "type": "object",
  "properties": {
    "$schema": {
      "description": "The URL of the schema the file is written against, for editors. Optional; a file is read against this Retake's schema whatever it names.",
      "type": "string"
    },
    "set": {
      "description": "The set the scene starts on; the project's defaultSet when not given.",
      "type": "string",
      "minLength": 1
    },
    "setup": {
      "description": "Steps played before recording starts. Nothing anchors to them, so they have no id.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/step"
      }
    },
    "leadIn": {
      "description": "Seconds recorded before the first step.",
      "type": "number",
      "minimum": 0,
      "default": 1
    },
    "tail": {
      "description": "Seconds recorded after the last step.",
      "type": "number",
      "minimum": 0,
      "default": 1
    },
    "defaultHold": {
      "description": "The hold of each step that doesn't give its own.",
      "type": "number",
      "minimum": 0,
      "default": 0
    },
    "recordsLaunch": {
      "description": "Starts recording before the app launches, to catch its launch screen.",
      "type": "boolean",
      "default": false
    },
    "orientation": {
      "description": "The orientation the device is turned to before the app launches.",
      "type": "string",
      "enum": ["portrait", "portrait-upside-down", "landscape-left", "landscape-right"],
      "default": "portrait"
    },
    "steps": {
      "description": "What the scene does, in order.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/step"
      },
      "minItems": 1
    }
  },
  "required": ["steps"],
  "additionalProperties": false,
  "$defs": {
    "step": {
      "description": "One thing the scene does, led by what it does, and the pause after it. A step can be only a hold.",
      "type": "object",
      "properties": {
        "tap": {
          "description": "Touches a point, x and y, or an element. A tap by point is drawn in the video; one on an element isn't.",
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "x": {
                  "description": "Screen points from the left.",
                  "type": "number",
                  "minimum": 0
                },
                "y": {
                  "description": "Screen points from the top.",
                  "type": "number",
                  "minimum": 0
                }
              },
              "required": ["x", "y"],
              "additionalProperties": false
            },
            {
              "$ref": "#/$defs/element"
            }
          ]
        },
        "drag": {
          "description": "A straight one-finger drag from one point to another.",
          "type": "object",
          "properties": {
            "from": {
              "description": "Where the finger comes down.",
              "type": "object",
              "properties": {
                "x": {
                  "description": "Screen points from the left.",
                  "type": "number",
                  "minimum": 0
                },
                "y": {
                  "description": "Screen points from the top.",
                  "type": "number",
                  "minimum": 0
                }
              },
              "required": ["x", "y"],
              "additionalProperties": false
            },
            "to": {
              "description": "Where it lifts.",
              "type": "object",
              "properties": {
                "x": {
                  "description": "Screen points from the left.",
                  "type": "number",
                  "minimum": 0
                },
                "y": {
                  "description": "Screen points from the top.",
                  "type": "number",
                  "minimum": 0
                }
              },
              "required": ["x", "y"],
              "additionalProperties": false
            },
            "duration": {
              "description": "Seconds the drag takes.",
              "type": "number",
              "exclusiveMinimum": 0,
              "default": 0.5
            }
          },
          "required": ["from", "to"],
          "additionalProperties": false
        },
        "type": {
          "description": "Types text key by key on the on-screen keyboard.",
          "type": "object",
          "properties": {
            "text": {
              "description": "What to type; \\n presses return.",
              "type": "string",
              "minLength": 1
            },
            "into": {
              "$ref": "#/$defs/element",
              "description": "The element to type into; the field already being typed in when not given."
            }
          },
          "required": ["text"],
          "additionalProperties": false
        },
        "activate": {
          "$ref": "#/$defs/element",
          "description": "An accessibility activation of an element, with no touch, for getting somewhere off camera."
        },
        "orientation": {
          "description": "Turns the device, with no hand on it; the step ends when the app has turned.",
          "type": "string",
          "enum": [
            "portrait",
            "portrait-upside-down",
            "landscape-left",
            "landscape-right"
          ]
        },
        "waitFor": {
          "description": "Waits until an element is on screen, or with gone until it isn't. The step fails if it doesn't happen in time.",
          "type": "object",
          "properties": {
            "label": {
              "description": "Its accessibility label.",
              "type": "string",
              "minLength": 1
            },
            "value": {
              "description": "Its value: a text field's placeholder, or what's typed in it.",
              "type": "string"
            },
            "identifier": {
              "description": "The accessibilityIdentifier the app gives it.",
              "type": "string",
              "minLength": 1
            },
            "hint": {
              "description": "Its accessibility hint: what VoiceOver says it does.",
              "type": "string",
              "minLength": 1
            },
            "traits": {
              "description": "Traits it has, every one, by The Button Heist's names, as `retake compose` prints them.",
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "adjustable",
                  "alert",
                  "allowsDirectInteraction",
                  "autoCorrectCandidate",
                  "backButton",
                  "button",
                  "causesPageTurn",
                  "deleteKey",
                  "draggable",
                  "footer",
                  "header",
                  "image",
                  "inactive",
                  "isEditing",
                  "keyboardKey",
                  "launchIcon",
                  "link",
                  "map",
                  "menuItem",
                  "notEnabled",
                  "pickerElement",
                  "playsSound",
                  "popupButton",
                  "radioButton",
                  "searchField",
                  "secureTextField",
                  "selected",
                  "selectionDismissesItem",
                  "spacer",
                  "startsMediaSession",
                  "staticText",
                  "statusBarElement",
                  "summaryElement",
                  "switchButton",
                  "tabBar",
                  "tabBarItem",
                  "tableIndex",
                  "textArea",
                  "textEntry",
                  "textOperationsAvailable",
                  "updatesFrequently",
                  "visited",
                  "webContent"
                ]
              },
              "minItems": 1,
              "uniqueItems": true,
              "examples": [
                ["header"],
                ["button", "selected"]
              ]
            },
            "occurrence": {
              "description": "Which of several matching elements, counted from 1 in the order VoiceOver reads the screen.",
              "type": "integer",
              "minimum": 1
            },
            "gone": {
              "description": "Waits for the element to leave instead.",
              "type": "boolean",
              "default": false
            },
            "timeout": {
              "description": "Seconds to wait.",
              "type": "number",
              "exclusiveMinimum": 0,
              "default": 10
            }
          },
          "additionalProperties": false,
          "anyOf": [
            {
              "required": ["label"]
            },
            {
              "required": ["value"]
            },
            {
              "required": ["identifier"]
            },
            {
              "required": ["hint"]
            },
            {
              "required": ["traits"]
            }
          ]
        },
        "hold": {
          "description": "Seconds to pause after the step, or for a tap, from when it's sent; the scene's defaultHold when not given.",
          "type": "number",
          "minimum": 0
        },
        "id": {
          "description": "The name edits anchor to. Unique in the scene; it can't look like a number, which anchors count steps by, nor be start or end.",
          "type": "string",
          "minLength": 1,
          "not": {
            "type": "string",
            "enum": ["start", "end"]
          }
        }
      },
      "additionalProperties": false,
      "oneOf": [
        {
          "required": ["tap"]
        },
        {
          "required": ["drag"]
        },
        {
          "required": ["type"]
        },
        {
          "required": ["activate"]
        },
        {
          "required": ["orientation"]
        },
        {
          "required": ["waitFor"]
        },
        {
          "required": ["hold"],
          "not": {
            "anyOf": [
              {
                "required": ["tap"]
              },
              {
                "required": ["drag"]
              },
              {
                "required": ["type"]
              },
              {
                "required": ["activate"]
              },
              {
                "required": ["orientation"]
              },
              {
                "required": ["waitFor"]
              }
            ]
          }
        }
      ]
    },
    "element": {
      "description": "An element on screen, as VoiceOver knows it: by any of its label, value, identifier, hint and traits.",
      "type": "object",
      "properties": {
        "label": {
          "description": "Its accessibility label.",
          "type": "string",
          "minLength": 1
        },
        "value": {
          "description": "Its value: a text field's placeholder, or what's typed in it.",
          "type": "string"
        },
        "identifier": {
          "description": "The accessibilityIdentifier the app gives it.",
          "type": "string",
          "minLength": 1
        },
        "hint": {
          "description": "Its accessibility hint: what VoiceOver says it does.",
          "type": "string",
          "minLength": 1
        },
        "traits": {
          "description": "Traits it has, every one, by The Button Heist's names, as `retake compose` prints them.",
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "adjustable",
              "alert",
              "allowsDirectInteraction",
              "autoCorrectCandidate",
              "backButton",
              "button",
              "causesPageTurn",
              "deleteKey",
              "draggable",
              "footer",
              "header",
              "image",
              "inactive",
              "isEditing",
              "keyboardKey",
              "launchIcon",
              "link",
              "map",
              "menuItem",
              "notEnabled",
              "pickerElement",
              "playsSound",
              "popupButton",
              "radioButton",
              "searchField",
              "secureTextField",
              "selected",
              "selectionDismissesItem",
              "spacer",
              "startsMediaSession",
              "staticText",
              "statusBarElement",
              "summaryElement",
              "switchButton",
              "tabBar",
              "tabBarItem",
              "tableIndex",
              "textArea",
              "textEntry",
              "textOperationsAvailable",
              "updatesFrequently",
              "visited",
              "webContent"
            ]
          },
          "minItems": 1,
          "uniqueItems": true,
          "examples": [
            ["header"],
            ["button", "selected"]
          ]
        },
        "occurrence": {
          "description": "Which of several matching elements, counted from 1 in the order VoiceOver reads the screen.",
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false,
      "anyOf": [
        {
          "required": ["label"]
        },
        {
          "required": ["value"]
        },
        {
          "required": ["identifier"]
        },
        {
          "required": ["hint"]
        },
        {
          "required": ["traits"]
        }
      ]
    }
  }
}
